import os
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
import requests

app = FastAPI()

# Les 4 numéros de l'application associés silencieusement par réseau
APP_MERCHANT_NUMBERS = {
    "airtel": "243971802077",
    "orange": "243844569840",
    "mpesa": "243821001743",
    "africell": "243901617621",
}


class MobilePaymentRequest(BaseModel):
    client_phone: str
    operator: str
    amount: float


@app.post("/api/pay/mobile")
def process_mobile_payment(payment: MobilePaymentRequest):
    operator_key = payment.operator.lower()

    if operator_key not in APP_MERCHANT_NUMBERS:
        raise HTTPException(
            status_code=400, detail="Opérateur non pris en charge."
        )

    destination_number = APP_MERCHANT_NUMBERS[operator_key]

    # Envoi de la demande de Push au téléphone de l'utilisateur
    payload = {
        "merchant": os.getenv("FLEXPAY_MERCHANT_CODE"),
        "type": "1",  # Mobile Money
        "phone": payment.client_phone,  # Téléphone du client
        "destination": destination_number,  # Numéro récepteur de l'app
        "amount": payment.amount,
        "currency": "USD",
        "reference": f"MOSALA-{payment.client_phone[-4:]}",
        "callbackUrl": "https://votre-domaine.com/api/payment/callback",
    }

    headers = {
        "Authorization": f"Bearer {os.getenv('FLEXPAY_TOKEN')}",
        "Content-Type": "application/json",
    }

    response = requests.post(
        "https://backend.flexpay.cd/api/rest/v1/paymentService",
        json=payload,
        headers=headers,
    )

    if response.status_code == 200:
        return {
            "status": "success",
            "message": "Invite PIN envoyée sur le téléphone.",
        }
    else:
        raise HTTPException(
            status_code=400, detail="Échec lors du déclenchement du paiement."
        )
