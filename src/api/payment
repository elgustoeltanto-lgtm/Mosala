# main.py ou api/payment.py
import os
import requests
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel

app = FastAPI()

# Dictionnaire d'association Opérateur -> Numéro bénéficiaire de l'application
APP_MERCHANT_NUMBERS = {
    "airtel": "243971802077",  # Airtel Money
    "orange": "243844569840",  # Orange Money
    "mpesa": "243821001743",  # Vodacom M-Pesa
    "africell": "243901617621",  # Africell Money
}


class PaymentRequest(BaseModel):
    client_phone: str  # Numéro du client qui paye
    operator: str  # "mpesa", "orange", "airtel", "africell"
    amount: float


@app.post("/api/pay/mobile")
def initiate_payment(payment: PaymentRequest):
    operator_key = payment.operator.lower()

    if operator_key not in APP_MERCHANT_NUMBERS:
        raise HTTPException(
            status_code=400, detail="Opérateur non pris en charge."
        )

    # Numéro qui recevra les fonds de l'application
    destination_number = APP_MERCHANT_NUMBERS[operator_key]

    # --- Exemple avec l'API FlexPay / Agrégateur ---
    payload = {
        "merchant": os.getenv("FLEXPAY_MERCHANT_CODE"),
        "type": "1",
        "phone": payment.client_phone,  # Téléphone du client à débiter
        "destination": destination_number,  # Votre numéro récepteur
        "amount": payment.amount,
        "currency": "USD",
        "reference": f"MOSALA-{payment.client_phone[-4:]}",
        "callbackUrl": "https://votre-domaine.com/api/payment/callback",
    }

    headers = {
        "Authorization": f"Bearer {os.getenv('FLEXPAY_TOKEN')}",
        "Content-Type": "application/json",
    }

    # Envoi de la demande USSD Push vers le téléphone du client
    response = requests.post(
        "https://backend.flexpay.cd/api/rest/v1/paymentService",
        json=payload,
        headers=headers,
    )

    if response.status_code == 200:
        return {
            "status": "pending",
            "message": f"Demande envoyée au {payment.client_phone}. Saisissez votre code PIN pour transférer les frais vers le compte de l'application ({destination_number}).",
        }
    else:
        raise HTTPException(
            status_code=400, detail="Échec de l'initialisation du paiement."
        )
